{
  "name": "@pokutuna/mcp-chrome-tabs",
  "version": "0.8.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/pokutuna/mcp-chrome-tabs"
  },
  "license": "MIT",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chrome",
    "ai",
    "macos"
  ],
  "bin": {
    "mcp-chrome-tabs": "./dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "CHANGELOG.md",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx src/cli.ts",
    "inspector": "npx @modelcontextprotocol/inspector",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "defuddle": "^0.19.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "playwright": "^1.54.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.0"
  }
}
